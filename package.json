{
  "name": "nexo-agent",
  "version": "0.0.18",
  "private": true,
  "author": "NexoBridge",
  "description": "Nexo Agent desktop and web console built with Electron, React, TypeScript, and Ant Design.",
  "main": "dist-electron/electron/bootstrap.js",
  "scripts": {
    "dev:electron": "node -e \"require('node:fs').rmSync('dist-electron', { recursive: true, force: true })\" && concurrently -k -n vite,electron-ts,electron \"vite --host 0.0.0.0\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:8106 file:dist-electron/electron/bootstrap.js file:dist-electron/electron/main.js file:dist-electron/electron/preload.js && cross-env VITE_DEV_SERVER_URL=http://localhost:8106 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:app": "node scripts/generate-icons.mjs && npm run typecheck && vite build && node -e \"require('node:fs').rmSync('dist-electron', { recursive: true, force: true })\" && tsc -p tsconfig.electron.json",
    "build:electron": "npm run build:app && electron-builder --publish never",
    "package:win": "npm run build:app && electron-builder --win --publish never",
    "package:mac": "npm run build:app && electron-builder --mac --publish never",
    "package:linux": "npm run build:app && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.2",
    "@langchain/textsplitters": "^1.0.1",
    "@types/sql.js": "^1.4.11",
    "antd": "^5.22.5",
    "busboy": "^1.6.0",
    "chromadb": "^3.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "langchain": "^1.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.14.1",
    "uuid": "^11.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sass": "^1.102.0",
    "sharp": "^0.32.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.company.nexoagent",
    "productName": "Nexo Agent",
    "icon": "assets/nexoagent-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "nexo/tools.json",
      "nexo/skills/**/*",
      "assets/nexoagent-icon.png",
      "assets/nexoagent-icon.ico",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/chromadb/**/*",
      "node_modules/chromadb-js-bindings-*/*"
    ],
    "win": {
      "icon": "assets/nexoagent-icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/nexoagent-icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/nexoagent-icon.ico",
      "uninstallerIcon": "assets/nexoagent-icon.ico",
      "installerHeaderIcon": "assets/nexoagent-icon.ico"
    }
  }
}
